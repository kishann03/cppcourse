CODE 1 - Character Search 

#include<bits/stdc++.h>
using namespace std;
//blueprint
int linearsearch(string str, char ch){
    int n = str.length()-1;
    for (int i = 0; i<=n; i++){
        if( str[i]==ch)
        {
            return i;
        }
    }
    return -1;
}
int main(){
    string str = "developer";
    char ch = 'e';
    int index = linearsearch(str,ch);    //call by value.
    cout<<"the index value is "<<index;
}



CODE 2 - Character Last Occurrence

#include<bits/stdc++.h>
using namespace std;
int linearsearch(string str, char ch){
    int index = -1;
    int n = str.length()-1;
    for (int i = 0; i<=n; i++){
        if( str[i]==ch)
        {
            index = i;
        }
    }
    return index;
}
int main(){
    string str = "developer";
    char ch = 'e';
    int index = linearsearch(str,ch);//call by value.
    cout<<"index  "<<index;
}
